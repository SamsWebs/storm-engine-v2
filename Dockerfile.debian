FROM storminator16/igloo-testing:latest

# Install dependencies missing from the base image
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglm-dev \
    libgtk-3-dev \
    liblua5.4-dev \
    && ln -sf $(find /usr/lib -name 'liblua5.4.so' | head -1) /usr/local/lib/liblua.so \
    && rm -rf /var/lib/apt/lists/*

# # Copy the source code into the container
RUN mkdir -p /opt/library
COPY ./common /opt/library/common
COPY ./vendor /opt/library/vendor
COPY ./specs /opt/library/specs
# specs/examples covers pure example logic (touch controls) via relative includes
COPY ./examples/android-platformer/src/input /opt/library/examples/android-platformer/src/input
COPY ./Makefile.debian /opt/library/Makefile
COPY ./base.mk /opt/library/base.mk

# Build the project
WORKDIR /opt/library
CMD ["make", "test"]