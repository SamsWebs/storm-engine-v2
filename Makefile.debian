#!/bin/bash

BIN				= libstormenginev2.so
TEST_BIN		= tests
BIN_DIR   		= ./bin
TARGET 			= $(BIN_DIR)/$(BIN)
TEST_TARGET 	= $(BIN_DIR)/$(TEST_BIN)

# No `clean` prerequisite here any more. base.mk now compiles with -MMD -MP
# and the .d files it writes are pulled back in at the bottom of this file, so
# editing a header rebuilds every object that includes it. The unconditional
# clean existed only to paper over that gap and made every build a full one.
# Switching PROFILE is handled too — base.mk stamps the flags and every object
# depends on that stamp, so -O0 and -O2 objects can no longer be mixed.
# check-engine-sources is an order-free goal, not a file prereq: listing a
# .PHONY here would make test-target always relink. `all` runs it first so a
# local full build still catches a stale list without waiting for CI.
all: check-engine-sources test-target run-test target

include ./base.mk

# One canonical source list, read by every build path (debian, win, Switch,
# Android). CI fails if it drifts from `find common -name '*.cpp'`.
# grep '^common/', not awk '/!^#/': a bare `#` inside $(shell …) starts a make
# comment and truncates the call (unterminated shell), and `$$` before `)`
# unbalances make's paren scan.
ENGINE_SOURCES = $(shell grep '^common/' engine-sources.txt)
LIBSRCS  = $(ENGINE_SOURCES)
LIBOBJS  = $(LIBSRCS:.cpp=.o)

.PHONY: check-engine-sources
check-engine-sources:
	@listed=$$(mktemp); actual=$$(mktemp); \
	trap 'rm -f $$listed $$actual' EXIT; \
	grep '^common/' engine-sources.txt | sort > $$listed; \
	find common -name '*.cpp' | sort > $$actual; \
	if ! diff -u $$listed $$actual; then \
	  echo "engine-sources.txt is stale. Regenerate:"; \
	  echo "  find common -name '*.cpp' | sort"; \
	  echo "and merge into engine-sources.txt (keep the # header comments)."; \
	  exit 1; \
	fi; \
	echo "engine-sources.txt is up to date."

# tinyxml2 is COMPILED IN rather than linked -- see the LIB comment in base.mk
# for why the soname had to go. Two details are deliberate:
#
#  * The object is written to common/, not beside its source. base.mk's `clean`
#    prunes $(ROOT_DIR)/vendor/android, so an object left in the submodule
#    would never be cleaned and would show up as a dirty submodule in every
#    `git status` afterwards.
#  * The symbols stay EXPORTED. stormengine2.pc used to name tinyxml2 in
#    Requires: because XmlLoader embeds an XMLDocument by value, so a game's
#    own translation unit emits ~XMLDocument and needs the symbol at link time.
#    It now resolves that from libstormenginev2.so itself.
TINYXML2_DIR = $(ROOT_DIR)/vendor/android/tinyxml2
TINYXML2_OBJ = common/tinyxml2.o

$(TINYXML2_OBJ): $(TINYXML2_DIR)/tinyxml2.cpp $(ROOT_DIR)/base.mk $(FLAGSTAMP)
	$(CC) $(CCFLAGS) -o $@ $<

target : $(LIBOBJS) $(TINYXML2_OBJ)
	mkdir -p $(BIN_DIR)
	$(CC) $^ $(LIB) -shared -o $(TARGET)

# Staging prefix. .github/workflows/build-and-release.yml packages the .deb by
# running `make install DESTDIR=<staging>` rather than re-implementing the
# copy, so the tree the package ships and the tree a from-source install
# produces cannot drift apart.
DESTDIR ?=
PREFIX ?= /usr/local
INSTALL_INCLUDE_DIR = $(DESTDIR)$(PREFIX)/include/stormengine2
INSTALL_LIB_DIR = $(DESTDIR)$(PREFIX)/lib
INSTALL_PKGCONFIG_DIR = $(INSTALL_LIB_DIR)/pkgconfig
INSTALL_SHARE_DIR = $(DESTDIR)$(PREFIX)/share/stormengine2

# Stamped into stormengine2.pc. The release workflow already knows the real
# version; override it there. It is metadata only -- pkg-config reports it,
# nothing links against it.
VERSION ?= 2.3.1

# The include dir is wiped before the copy: a bare `cp -r` never removes
# anything, so headers and whole directories deleted from common/ lived on in
# /usr/local/include/stormengine2 forever. The find then strips the build
# by-products cp drags along — the old `rm -r .../*.o` matched the top level
# only, left common/net/*.o and every .cpp behind, and failed outright when
# the glob matched nothing.
install:
	rm -rf $(INSTALL_INCLUDE_DIR)
	mkdir -p $(INSTALL_INCLUDE_DIR) $(INSTALL_LIB_DIR)
	cp $(TARGET) $(INSTALL_LIB_DIR)
	cp -r ./common/* $(INSTALL_INCLUDE_DIR)
	# xmlLoader.h does #include "tinyxml2.h" and embeds an XMLDocument by
	# value, so a consumer compiles against tinyxml2 whether it wants to or
	# not. Shipping the vendored header beside it is what makes the quoted
	# include resolve, and guarantees the consumer and the library agree on
	# the version -- the package no longer depends on a system tinyxml2 at
	# all, so there may not be one.
	cp $(TINYXML2_DIR)/tinyxml2.h $(INSTALL_INCLUDE_DIR)/tinyxml2.h
	find $(INSTALL_INCLUDE_DIR) \( -name '*.o' -o -name '*.d' -o -name '*.cpp' \) -delete
	# pkg-config file. Without it a game has to name SDL2, SDL2_image, SDL2_ttf,
	# SDL2_mixer and tinyxml2 on its own link line -- linking only
	# -lstormenginev2 fails with "DSO missing from command line" the moment the
	# game calls SDL directly, which every real game does.
	mkdir -p $(INSTALL_PKGCONFIG_DIR)
	sed -e 's|@PREFIX@|$(PREFIX)|g' -e 's|@VERSION@|$(VERSION)|g' \
	    stormengine2.pc.in > $(INSTALL_PKGCONFIG_DIR)/stormengine2.pc
	# Starter game. Every example's Makefile is `include ../examples.mk`, which
	# needs base.mk from the source tree -- so a .deb-only user has no Makefile
	# to copy from. This one builds with pkg-config and no engine source.
	rm -rf $(INSTALL_SHARE_DIR)/template
	mkdir -p $(INSTALL_SHARE_DIR)
	cp -r ./template $(INSTALL_SHARE_DIR)/template

test: check-engine-sources test-target run-test

TESTSRCS  	:= $(shell find specs -name '*.cpp')
TESTSRCS  	+= $(ENGINE_SOURCES)
TESTOBJS  	= $(TESTSRCS:.cpp=.o)

# Ordering prerequisite, not just a listed goal: without it `make -j test`
# could start the test binary before the link that produces it.
run-test: test-target
	$(TEST_TARGET)

# $(TINYXML2_OBJ) is listed explicitly because TESTSRCS reads engine-sources.txt
# (every common/*.cpp), and this object's SOURCE lives in vendor/android/tinyxml2
# -- only the .o lands in common/. Without it the specs link against nothing for
# every tinyxml2 symbol xmlLoader.cpp names.
test-target: $(TESTOBJS) $(TINYXML2_OBJ)
	mkdir -p $(BIN_DIR)
	$(CC) $^ $(LIB) -pthread -o $(TEST_TARGET)

# Header dependency tracking. Both lists overlap on common/, hence the sort.
-include $(sort $(LIBOBJS:.o=.d) $(TESTOBJS:.o=.d))
