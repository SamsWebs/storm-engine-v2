# ── Windows build (MinGW-w64 cross-compile from Linux) ──────────────────────
#
# Produces build/win/libstormenginev2.dll and build/win/tests.exe.
#
# SDL2 and satellites are cross-built from the SAME vendored sources the
# Android build uses (vendor/android/ — upstream libsdl-org at release-2.30.11).
# Nothing is downloaded; Windows cannot drift to a different SDL than Android.
#
# Prerequisites:
#   sudo apt install mingw-w64 cmake
#
# Targets:
#   make -f Makefile.win           deps (once) + lib + tests
#   make -f Makefile.win deps      just build the vendored libraries
#   make -f Makefile.win test      run the spec suite under Wine
#   make -f Makefile.win dist      zip a redistributable SDK (see `dist:` below)
#   make -f Makefile.win clean     drop objects (keeps deps)
#   make -f Makefile.win distclean drop everything including deps

BUILD     := build/win
OBJDIR    := $(BUILD)/obj
DEPS      := $(CURDIR)/$(BUILD)/deps
TOOLCHAIN := $(CURDIR)/cmake/toolchain-mingw64.cmake
VENDOR    := vendor/android

CROSS := x86_64-w64-mingw32
# The -posix variant, not the bare one: specs/net/netLoopback.spec.cpp uses
# <thread>, which the win32-threads gcc does not implement. cmake/toolchain-
# mingw64.cmake must name the matching -posix compilers — mixing the two
# threading models across the deps/engine link boundary is an ABI hazard, not
# just a link error waiting to happen.
CXX   := $(CROSS)-g++-posix

# glm from the vendored tree — engine collider headers need it and there is
# no glm in the mingw sysroot. Deliberately no host include path here: this is
# a cross-compile, and /usr/local/include holds native x86-64 Linux SDL2 and
# glm that would be substituted silently the moment a header went missing from
# the paths above. See SPEC_CXXFLAGS for the one place it is still needed.
CXXFLAGS := -std=c++17 -Wall -Wextra -O2 -fPIC \
            -D_WIN32_WINNT=0x0600 \
            -Icommon -I$(VENDOR)/glm \
            -I$(DEPS)/include -I$(DEPS)/include/SDL2 \
            -MMD -MP

# igloo is header-only, is not vendored, and exists only under /usr/local, so
# the spec suite cannot compile without the host path. Scoped to specs/ alone:
# it is the test harness, it is not linked into the shipped DLL, and none of
# the 13 engine translation units can pick a native Linux header from it.
# -isystem rather than -I so it stays last in the search order.
SPEC_CXXFLAGS := $(CXXFLAGS) -isystem /usr/local/include

# -mconsole keeps stdout visible (Logger), which is the only diagnostic on a
# headless Windows box. Switch to -mwindows when shipping.
#
# -static-libgcc -static-libstdc++ WERE HERE AND WERE WRONG FOR THE DLL.
# Statically linking the GCC runtime into a shared library absorbs libgcc_eh,
# and MinGW exports every symbol by default, so libstormenginev2.dll re-exported
# `_Unwind_Resume`. Any consumer that also linked -static-libgcc then failed:
#
#   multiple definition of `_Unwind_Resume';
#   libstormenginev2.dll.a(...) first defined here
#
# It was invisible for as long as nothing linked the DLL -- the spec suite links
# the engine OBJECTS, and examples.win.mk used to compile the engine into each
# example. The first thing to actually consume the shipped library found it.
#
# A shared library and its consumers must share ONE runtime, so the DLLs are
# staged beside the binaries instead; stage-dlls derives them from the real
# import table and now picks up libgcc_s_seh-1.dll and libstdc++-6.dll on its
# own. That is also why they must not be re-added to an example's link line.
LDFLAGS := -L$(DEPS)/lib -mconsole
LIBS    := -lmingw32 -lSDL2main -lSDL2 -lSDL2_image -lSDL2_ttf -lSDL2_mixer \
           -ltinyxml2 -lws2_32

# Engine sources — recursive, same as Makefile.debian
LIBSRCS := $(shell find common -name '*.cpp')
LIBOBJS := $(patsubst common/%.cpp, $(OBJDIR)/engine/%.o, $(LIBSRCS))

# Spec sources + engine sources (specs link the engine statically)
TESTSRCS := $(shell find specs -name '*.cpp')
TESTOBJS := $(patsubst specs/%.cpp, $(OBJDIR)/specs/%.o, $(TESTSRCS))

DEPFILES = $(patsubst %.o,%.d,$(LIBOBJS) $(TESTOBJS))

DEPS_STAMP := $(DEPS)/.stamp

TARGET      := $(BUILD)/libstormenginev2.dll
TEST_TARGET := $(BUILD)/tests.exe

# The import library. MinGW can link straight against a .dll, but that is a
# convention consumers should not be made to rely on and MSVC cannot do it at
# all; every other prebuilt Windows SDK ships one. Generated by the link rule
# below rather than a separate step, so it cannot go stale against the DLL.
IMPLIB      := $(BUILD)/libstormenginev2.dll.a

# Stamped into the zip name and its README. Overridden by the release workflow
# with the tag's version, exactly as Makefile.debian's VERSION is -- keep the
# default in step with that file's.
VERSION   ?= 2.1.1
DISTNAME  := stormengine2-$(VERSION)-win64
DISTDIR   := $(BUILD)/$(DISTNAME)
DISTZIP   := $(BUILD)/$(DISTNAME).zip

.PHONY: all deps test stage-dlls dist clean distclean

all: $(TARGET) $(TEST_TARGET)

# ── Vendored dependencies ───────────────────────────────────────────────────
deps: $(DEPS_STAMP)

$(DEPS_STAMP):
	@echo "Cross-building SDL2 + satellites for Windows (first run only)…"
	@mkdir -p $(BUILD)/dep-build
	@for lib in SDL2 SDL_image2 SDL_ttf2 SDL_mixer2 tinyxml2; do \
	  echo "  → $$lib"; \
	  shared=ON; \
	  case $$lib in tinyxml2) shared=OFF;; esac; \
	  cmake -S $(VENDOR)/$$lib -B $(BUILD)/dep-build/$$lib \
	    -DCMAKE_TOOLCHAIN_FILE=$(TOOLCHAIN) \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DCMAKE_INSTALL_PREFIX=$(DEPS) \
	    -DCMAKE_PREFIX_PATH=$(DEPS) \
	    -DWIN_DEPS_PREFIX=$(DEPS) \
	    -DBUILD_SHARED_LIBS=$$shared \
	    -DSDL_TEST=OFF -DSDL2IMAGE_SAMPLES=OFF -DSDL2TTF_SAMPLES=OFF \
	    -DSDL2MIXER_SAMPLES=OFF \
	    -DSDL2IMAGE_VENDORED=OFF -DSDL2TTF_VENDORED=ON -DSDL2MIXER_VENDORED=OFF \
	    -DSDL2TTF_HARFBUZZ=OFF \
	    -DSDL2MIXER_FLAC=OFF -DSDL2MIXER_MOD=OFF -DSDL2MIXER_MIDI=OFF \
	    -DSDL2MIXER_OPUS=OFF -DSDL2MIXER_WAVPACK=OFF \
	    -Dtinyxml2_BUILD_TESTING=OFF \
	    > $(BUILD)/dep-build/$$lib-configure.log 2>&1 || \
	    { echo "configure failed for $$lib — see $(BUILD)/dep-build/$$lib-configure.log"; exit 1; }; \
	  cmake --build $(BUILD)/dep-build/$$lib --target install -j$$(nproc) \
	    > $(BUILD)/dep-build/$$lib-build.log 2>&1 || \
	    { echo "build failed for $$lib — see $(BUILD)/dep-build/$$lib-build.log"; exit 1; }; \
	done
	@touch $@

# ── Shared library ─────────────────────────────────────────────────────────
$(TARGET): $(DEPS_STAMP) $(LIBOBJS)
	@mkdir -p $(BUILD)
	$(CXX) -shared -o $@ -Wl,--out-implib,$(IMPLIB) $(LIBOBJS) $(LDFLAGS) $(LIBS)
	@$(MAKE) --no-print-directory -f Makefile.win stage-dlls

# ── Spec suite ──────────────────────────────────────────────────────────────
$(TEST_TARGET): $(DEPS_STAMP) $(TESTOBJS) $(LIBOBJS)
	@mkdir -p $(BUILD)
	$(CXX) -o $@ $(TESTOBJS) $(LIBOBJS) $(LDFLAGS) $(LIBS)
	@$(MAKE) --no-print-directory -f Makefile.win stage-dlls

test: $(TEST_TARGET)
	wine64 $(TEST_TARGET)

# Neither tests.exe nor libstormenginev2.dll starts without its DLLs beside it,
# and Windows says nothing useful when one is missing — under Wine it was a
# bare "exit 53" with no output at all. Hardcoding the list is exactly what
# produced that: the first attempt shipped libwinpthread-1.dll but not
# libstdc++-6.dll, which a vendored DLL pulled in. So resolve the import graph
# instead and copy whatever is still unresolved out of the mingw runtime. This
# is not decorative — the deps stage does not carry the exe's -static-libgcc
# -static-libstdc++ (see LDFLAGS), so re-enabling an SDL_mixer/SDL_image codec
# or flipping a VENDORED flag can add a C++ runtime import to a vendored DLL
# with nothing else to catch it.
#
# Three passes because a DLL staged in one pass brings imports of its own; the
# loop stops early once a pass stages nothing. The final loop warns about
# anything still unresolved that the mingw runtime could have supplied — the
# case that would otherwise surface as a silent non-zero exit under Wine.
#
# Resolution goes through $(CXX) -print-file-name first, which returns the
# runtime belonging to the compiler actually in use. That matters here:
# /usr/lib/gcc/$(CROSS) carries both a 9.3-posix and a 9.3-win32
# libstdc++-6.dll, and staging the win32 one beside a -posix build reintroduces
# the very ABI mismatch the toolchain file was fixed to avoid.
stage-dlls:
	@mkdir -p $(BUILD)
	@cp -u $(DEPS)/bin/*.dll $(BUILD)/ 2>/dev/null || true
	@cd $(BUILD) && \
	imports() { \
	  for f in $(notdir $(TARGET)) $(notdir $(TEST_TARGET)) *.dll; do \
	    [ -f "$$f" ] || continue; \
	    $(CROSS)-objdump -p "$$f" 2>/dev/null | awk '/DLL Name/ {print $$3}'; \
	  done | sort -u; \
	}; \
	runtime() { \
	  p=$$($(CXX) -print-file-name="$$1" 2>/dev/null); \
	  if [ -f "$$p" ]; then echo "$$p"; return 0; fi; \
	  find /usr/lib/gcc/$(CROSS) /usr/$(CROSS) -name "$$1" 2>/dev/null | head -1; \
	}; \
	for pass in 1 2 3; do \
	  found=0; \
	  for n in $$(imports); do \
	    [ -f "$$n" ] && continue; \
	    src=$$(runtime "$$n"); \
	    if [ -n "$$src" ]; then cp -u "$$src" .; found=1; fi; \
	  done; \
	  [ $$found -eq 0 ] && break; \
	done; \
	for n in $$(imports); do \
	  if [ ! -f "$$n" ] && [ -n "$$(runtime "$$n")" ]; then \
	    echo "WARNING: $$n is a mingw runtime DLL and was not staged"; \
	  fi; \
	done; \
	true

# ── Compile rules ───────────────────────────────────────────────────────────
$(OBJDIR)/engine/%.o: common/%.cpp | $(DEPS_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/specs/%.o: specs/%.cpp | $(DEPS_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(SPEC_CXXFLAGS) -c $< -o $@

# ── Redistributable SDK ─────────────────────────────────────────────────────
#
# Windows has no package manager to resolve a dependency, so this ships an SDK
# rather than a library: everything needed to COMPILE and RUN a game against
# the engine, in one zip. That is the same scope as the .deb, which installs
# headers, the library, a pkg-config file and the starter game.
#
# Why each piece is here, since every one of them is a build failure on a clean
# Windows box if it is not:
#
#  * bin/  — the engine DLL plus every DLL it imports. stage-dlls resolves the
#    real import graph (see its comment); hardcoding this list is what once
#    shipped libwinpthread-1.dll without libstdc++-6.dll.
#  * lib/  — the import library. See IMPLIB above.
#  * include/stormengine2/ — the engine headers, and tinyxml2.h beside them.
#    tinyxml2 is linked STATICALLY into the DLL here (deps builds it with
#    shared=OFF), so there is no tinyxml2 on the system to get a header from,
#    and XmlLoader embeds an XMLDocument by value -- a consumer's own TU emits
#    ~XMLDocument and must agree on the layout. Same reasoning as the .deb.
#  * include/SDL2/ and include/glm/ — 12 engine headers include <SDL2/SDL.h>
#    and 6 include <glm/...>, so a consumer cannot compile a single engine
#    header without both. On Debian these come from libsdl2-dev and libglm-dev;
#    on Windows they come from here or from nowhere.
#  * template/ — the starter game, matching what the .deb puts in
#    /usr/local/share/stormengine2.
#
# tests.exe is deliberately NOT shipped: it is the engine's own spec suite, not
# something a consumer runs.
dist: $(TARGET)
	@command -v zip >/dev/null || { echo "zip not found: sudo apt install zip"; exit 1; }
	rm -rf $(DISTDIR) $(DISTZIP)
	mkdir -p $(DISTDIR)/bin $(DISTDIR)/lib $(DISTDIR)/include/stormengine2
	# Every staged DLL, which is the engine's plus its whole import closure.
	cp $(BUILD)/*.dll $(DISTDIR)/bin/
	# Strip the redistributable copies only -- build/win keeps its symbols so a
	# local Wine debug session is unaffected. This is not a micro-optimisation:
	# GCC 13's libstdc++-6.dll ships 26.3 MB unstripped and 2.2 MB stripped, and
	# it is here at all because the DLL uses the SHARED GCC runtime (see LDFLAGS).
	# Makefile.debian's release profile strips for the same reason.
	find $(DISTDIR)/bin -name '*.dll' -exec $(CROSS)-strip --strip-unneeded {} +
	cp $(IMPLIB) $(DISTDIR)/lib/
	# The SDL2 import libraries, and libtinyxml2.a. Shipping only the engine's
	# implib made the zip unusable for its stated purpose: the README tells a
	# consumer to link SDL directly, every real game does, and the linker will not
	# let a program borrow its library's transitive imports -- so a game got
	# "cannot find -lSDL2_image" on the first build. Caught by
	# examples/windows-platformer, which is the only thing in the tree that builds
	# against the ZIP rather than against build/win.
	cp $(DEPS)/lib/libSDL2.dll.a $(DEPS)/lib/libSDL2main.a \
	   $(DEPS)/lib/libSDL2_image.dll.a $(DEPS)/lib/libSDL2_ttf.dll.a \
	   $(DEPS)/lib/libSDL2_mixer.dll.a $(DEPS)/lib/libtinyxml2.a \
	   $(DISTDIR)/lib/
	cp -r common/* $(DISTDIR)/include/stormengine2/
	find $(DISTDIR)/include/stormengine2 \
	     \( -name '*.o' -o -name '*.d' -o -name '*.cpp' \) -delete
	cp $(VENDOR)/tinyxml2/tinyxml2.h $(DISTDIR)/include/stormengine2/tinyxml2.h
	cp -r $(DEPS)/include/SDL2 $(DISTDIR)/include/SDL2
	cp -r $(VENDOR)/glm/glm $(DISTDIR)/include/glm
	cp -r template $(DISTDIR)/template
	rm -rf $(DISTDIR)/template/bin
	sed -e 's|@VERSION@|$(VERSION)|g' Makefile.win.README.in > $(DISTDIR)/README.txt
	cd $(BUILD) && zip -qr $(DISTNAME).zip $(DISTNAME)
	@echo "wrote $(DISTZIP)"
	@du -h $(DISTZIP)

clean:
	rm -rf $(OBJDIR) $(TARGET) $(TEST_TARGET) $(IMPLIB) $(DISTDIR) $(DISTZIP)

distclean:
	rm -rf $(BUILD)

-include $(DEPFILES)
