# ── Windows build (MinGW-w64 cross-compile from Linux) ──────────────────────
#
# Produces build/win/tf.exe plus the DLLs it needs, ready to zip.
#
# There is no Windows machine in this project's loop, so the build has to be
# reproducible from Linux and verifiable in CI. SDL2 and friends are compiled
# from the SAME pinned sources the Android build uses
# (external/storm-engine-v2/vendor/android/ — upstream libsdl-org at
# release-2.30.11, only under that directory by name). Nothing is downloaded,
# and Windows cannot drift to a different SDL than Android.
#
# Prerequisites:
#   sudo apt install mingw-w64 cmake
#   git submodule update --init --recursive external/storm-engine-v2
#
# Targets:
#   make -f Makefile.win           deps (once) + tf.exe + staged DLLs
#   make -f Makefile.win deps      just build the vendored libraries
#   make -f Makefile.win run       run it under Wine
#   make -f Makefile.win dist      zip build/win into build/tf2kxx-win64.zip
#   make -f Makefile.win clean     drop the game objects (keeps deps)
#   make -f Makefile.win distclean drop everything including deps

TARGET  := tf.exe
BUILD   := build/win
# Objects live in their own subtree. They used to sit directly under $(BUILD),
# where build/win/assets/ (objects for src/assets/) collided with the game's own
# assets/ directory when it was staged beside the exe to run it — deleting one
# silently wiped the other.
OBJDIR  := $(BUILD)/obj
SRCDIR  := src
ENGINE_DIR := external/storm-engine-v2/common
VENDOR  := external/storm-engine-v2/vendor/android

CROSS   := x86_64-w64-mingw32
CXX     := $(CROSS)-g++
DEPS    := $(CURDIR)/$(BUILD)/deps
TOOLCHAIN := $(CURDIR)/cmake/toolchain-mingw64.cmake

# glm comes from the engine's pinned vendor tree, the same copy the Android
# build uses — the engine's collider headers need it and there is no glm in the
# mingw sysroot.
CXXFLAGS := -std=c++17 -Wall -Wextra -O2 \
            -Iinclude -I$(SRCDIR) -I$(VENDOR)/glm \
            -I$(DEPS)/include -I$(DEPS)/include/SDL2 \
            -MMD -MP

# -mconsole, not -mwindows: keeps the Logger's stdout visible, which is the
# only way to diagnose this build without a Windows machine to attach to.
# Switch to -mwindows when it ships to players.
LDFLAGS := -L$(DEPS)/lib -mconsole -static-libgcc -static-libstdc++
LIBS    := -lmingw32 -lSDL2main -lSDL2 -lSDL2_image -lSDL2_ttf -lSDL2_mixer \
           -ltinyxml2

# src/data/leagueSave.cpp is the only sqlite3 consumer and there is no sqlite3
# here, exactly as on Switch and Android. common/net/ is skipped for the same
# reason as those two: nothing in the game references it yet.
SRCS    := $(filter-out $(SRCDIR)/data/leagueSave.cpp,$(shell find $(SRCDIR) -name '*.cpp'))
OBJS    := $(patsubst $(SRCDIR)/%.cpp, $(OBJDIR)/%.o, $(SRCS))

ENGINE_SRCS := $(wildcard $(ENGINE_DIR)/*.cpp)
ENGINE_OBJS := $(patsubst $(ENGINE_DIR)/%.cpp, $(OBJDIR)/engine/%.o, $(ENGINE_SRCS))

# Deferred (=), not immediate (:=) — same trap Makefile.linux documents: OBJS
# and ENGINE_OBJS are defined above here, but keep the habit.
DEPFILES = $(patsubst %.o,%.d,$(OBJS) $(ENGINE_OBJS))

# Marker file proving the deps stage finished, so it runs once rather than on
# every build.
DEPS_STAMP := $(DEPS)/.stamp

.PHONY: all deps run dist clean distclean

all: $(BUILD)/$(TARGET)

# ── Vendored dependencies ───────────────────────────────────────────────────
# SDL2 must be installed before the satellites configure, since they look for
# it via CMAKE_PREFIX_PATH.
deps: $(DEPS_STAMP)

$(DEPS_STAMP):
	@echo "Cross-building SDL2 + satellites for Windows (first run only)…"
	@for lib in SDL2 SDL_image2 SDL_ttf2 SDL_mixer2 tinyxml2; do \
	  echo "  → $$lib"; \
	  shared=ON; \
	  case $$lib in tinyxml2) shared=OFF;; esac; \
	  cmake -S $(VENDOR)/$$lib -B $(BUILD)/dep-build/$$lib \
	    -DCMAKE_TOOLCHAIN_FILE=$(TOOLCHAIN) \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DCMAKE_INSTALL_PREFIX=$(DEPS) \
	    -DCMAKE_PREFIX_PATH=$(DEPS) \
	    -DWIN_DEPS_PREFIX=$(DEPS) \
	    -DBUILD_SHARED_LIBS=$$shared \
	    -DSDL_TEST=OFF -DSDL2IMAGE_SAMPLES=OFF -DSDL2TTF_SAMPLES=OFF \
	    -DSDL2MIXER_SAMPLES=OFF \
	    -DSDL2IMAGE_VENDORED=ON -DSDL2TTF_VENDORED=ON -DSDL2MIXER_VENDORED=ON \
	    -DSDL2TTF_HARFBUZZ=OFF \
	    -DSDL2MIXER_FLAC=OFF -DSDL2MIXER_MOD=OFF -DSDL2MIXER_MIDI=OFF \
	    -DSDL2MIXER_OPUS=OFF -DSDL2MIXER_WAVPACK=OFF \
	    -Dtinyxml2_BUILD_TESTING=OFF \
	    > $(BUILD)/dep-build/$$lib-configure.log 2>&1 || \
	    { echo "configure failed for $$lib — see $(BUILD)/dep-build/$$lib-configure.log"; exit 1; }; \
	  cmake --build $(BUILD)/dep-build/$$lib --target install -j$$(nproc) \
	    > $(BUILD)/dep-build/$$lib-build.log 2>&1 || \
	    { echo "build failed for $$lib — see $(BUILD)/dep-build/$$lib-build.log"; exit 1; }; \
	done
	@touch $@

# ── Game ────────────────────────────────────────────────────────────────────
$(BUILD)/$(TARGET): $(DEPS_STAMP) $(OBJS) $(ENGINE_OBJS)
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(ENGINE_OBJS) $(LDFLAGS) $(LIBS)
	@$(MAKE) --no-print-directory -f Makefile.win stage-dlls

# The .exe will not start without its DLLs beside it, and Windows says nothing
# useful when one is missing — under Wine it was a bare "exit 53" with no
# output at all. So rather than hardcode a list (the first attempt shipped
# libwinpthread but not libstdc++, which a vendored DLL pulled in), resolve the
# import graph and copy whatever is still unresolved out of the mingw runtime.
.PHONY: stage-dlls
stage-dlls:
	@cp -u $(DEPS)/bin/*.dll $(BUILD)/ 2>/dev/null || true
	@cd $(BUILD) && for pass in 1 2 3; do \
	  missing=$$(for f in $(TARGET) *.dll; do \
	      $(CROSS)-objdump -p $$f 2>/dev/null | awk '/DLL Name/ {print $$3}'; \
	    done | sort -u | while read n; do \
	      [ -f "$$n" ] || echo "$$n"; \
	    done); \
	  found=0; \
	  for n in $$missing; do \
	    src=$$(find /usr/lib/gcc/$(CROSS) /usr/$(CROSS) -name "$$n" 2>/dev/null | head -1); \
	    if [ -n "$$src" ]; then cp -u "$$src" .; found=1; fi; \
	  done; \
	  [ $$found -eq 0 ] && break; \
	done; true
	@cd $(BUILD) && for f in $(TARGET) *.dll; do \
	    $(CROSS)-objdump -p $$f 2>/dev/null | awk '/DLL Name/ {print $$3}'; \
	  done | sort -u | while read n; do \
	    if [ ! -f "$$n" ] && find /usr/lib/gcc/$(CROSS) /usr/$(CROSS) -name "$$n" 2>/dev/null | grep -q .; then \
	      echo "WARNING: $$n is a mingw runtime DLL and was not staged"; \
	    fi; \
	  done

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp | $(DEPS_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/engine/%.o: $(ENGINE_DIR)/%.cpp | $(DEPS_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

run: all
	cd $(BUILD) && wine ./$(TARGET)

dist: all
	@rm -rf $(BUILD)/dist && mkdir -p $(BUILD)/dist
	@cp $(BUILD)/$(TARGET) $(BUILD)/*.dll $(BUILD)/dist/
	@cp -r assets $(BUILD)/dist/
	@mkdir -p $(BUILD)/dist/data && cp -r data/teams data/tct $(BUILD)/dist/data/
	@rm -f $(BUILD)/dist/data/teams/*.bak
	@cd $(BUILD)/dist && zip -qr ../../tf2kxx-win64.zip . && \
	  echo "wrote build/tf2kxx-win64.zip"

clean:
	rm -rf $(OBJDIR) $(BUILD)/$(TARGET) $(BUILD)/dist

distclean:
	rm -rf $(BUILD)

-include $(DEPFILES)
